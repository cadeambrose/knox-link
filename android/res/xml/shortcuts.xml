<?xml version="1.0" encoding="utf-8"?>
<!-- long-press the app icon: start the game on the main screen and Knox Link on the other -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="play"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_play"
        android:shortcutLongLabel="@string/shortcut_play_long">
        <intent
            android:action="io.github.knoxlink.PLAY"
            android:targetPackage="io.github.knoxlink.companion"
            android:targetClass="io.github.knoxlink.companion.LaunchActivity" />
    </shortcut>
</shortcuts>